# 数据库（默认 sqlite 文件）
DB_URL=sqlite:///./data/crm.db

# 抖音来客留资回调：配了密钥就校验 X-Signature（HMAC-SHA256 hex）
DOUYIN_WEBHOOK_SECRET=
# 本地联调 true，不请求抖音接口
MOCK_DOUYIN=true

# 抖音开放平台「生活服务商家应用」线索查询（来客后台留资表单的官方拉取方式）
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 来客品牌账户 ID（account_id）
DOUYIN_ACCOUNT_ID=
# 来客商户根账户 ID（请求头 Rpc-Transit-Life-Account，可选）
DOUYIN_ROOT_ACCOUNT_ID=
# 用户授权后拿到的 open_id（接口要求时必传）
DOUYIN_OPEN_ID=
# 定时拉取开关；首次上线先用 false，手动 POST /api/sync/douyin 验证
DOUYIN_SYNC_ENABLED=false
DOUYIN_SYNC_INTERVAL_SECONDS=300
DOUYIN_SYNC_LOOKBACK_MINUTES=60
# 线索落入延迟，end_time 至少回退 10 分钟
DOUYIN_LAG_MINUTES=10

# 企业微信自建应用（用于「联系我」活码、欢迎语、打标签）
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
# 接收回调的 Token / EncodingAESKey（企微后台随机生成）
WECOM_TOKEN=
WECOM_AES_KEY=
# 本地联调先置 true，不请求企微接口
WECOM_MOCK=true

# 短信：console 只打印，http 走真实网关
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_TEMPLATE=【图书卡】您的专属顾问已在企业微信等您，点击链接添加：{link}

# 首响 SLA
SLA_MINUTES=5
SLA_SCAN_SECONDS=60

# 订单回调鉴权（可选）
INTERNAL_API_KEY=

# 销售池：企业组/个人组，每日上限
SALES_POOL=[{"userid":"sale_enterprise_1","group":"enterprise","daily_limit":20},{"userid":"sale_personal_1","group":"personal","daily_limit":30}]
