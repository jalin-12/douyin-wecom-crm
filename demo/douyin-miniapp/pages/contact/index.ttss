/* pages/contact/index.ttss */
page { background: #f5f6fa; }

.container { padding: 64rpx 48rpx; min-height: 100vh; box-sizing: border-box; }

/* 加载中 */
.loading { text-align: center; padding-top: 200rpx; }
.spinner {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid #e6e8eb; border-top-color: #1677ff;
  border-radius: 50%; margin: 0 auto 24rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #888; }

/* 错误 */
.error {
  text-align: center; padding: 60rpx 40rpx;
  background: #fff1f0; border-radius: 12rpx;
  font-size: 26rpx; color: #cf1322;
}

/* 内容 */
.content { padding-top: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 40rpx; color: #2c3e50; }

.sales-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx 32rpx;
  margin-bottom: 32rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.sales-label { font-size: 24rpx; color: #999; }
.sales-name { font-size: 34rpx; font-weight: 600; margin-top: 8rpx; color: #1677ff; }

.qrcode-wrap {
  background: #fff; border-radius: 16rpx; padding: 48rpx 32rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.qrcode { width: 480rpx; height: 480rpx; display: block; margin: 0 auto 24rpx; border-radius: 8rpx; }
.tip { font-size: 26rpx; color: #666; line-height: 1.8; }

.actions { margin-top: 48rpx; }
.actions button { margin-bottom: 16rpx; border-radius: 48rpx; font-size: 30rpx; }
.actions .primary { background: #1677ff; color: #fff; }
.actions .secondary { background: #f0f2f5; color: #333; }

.footer { font-size: 22rpx; color: #bbb; text-align: center; margin-top: 48rpx; line-height: 1.6; }
